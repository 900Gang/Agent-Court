{
  "name": "agent-court",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fixtures": "node --conditions=react-server --import tsx tests/e2e/fixtures.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --conditions=react-server --env-file=.env.local --import tsx db/seed.ts",
    "check:routes": "node --import tsx scripts/check-routes-gated.ts",
    "check:bundle": "node --env-file-if-exists=.env.local --import tsx scripts/check-client-bundle.ts",
    "db:live-check": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/live-db-check.ts",
    "db:make-admin": "node --conditions=react-server --env-file=.env.local --import tsx scripts/make-admin.ts",
    "ratelimit:live-check": "node --conditions=react-server --env-file=.env.local --import tsx scripts/live-ratelimit-check.ts",
    "rescan:held": "node --conditions=react-server --env-file=.env.local --import tsx scripts/rescan-held.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.10",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
